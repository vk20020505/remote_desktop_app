{
  "name": "mouselink-desktop",
  "productName": "MouseLink Desktop",
  "version": "1.0.0",
  "description": "Control this computer from your phone",
  "main": "src/main.js",
  "author": "Vynova Labs",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:msix": "electron-builder --win appx",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "4.2.6"
  },
  "devDependencies": {
    "electron": "44.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.app.mouselinkdesktop",
    "productName": "MouseLink Desktop",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "artifactName": "MouseLink-Desktop-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSAppleEventsUsageDescription": "MouseLink Desktop uses System Events to list and switch apps and to shut down or restart from your phone."
      }
    },
    "dmg": {
      "title": "MouseLink Desktop"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "MouseLink Desktop"
    },
    "portable": {
      "artifactName": "MouseLink-Desktop-${version}-portable.${ext}"
    },
    "appx": {
      "applicationId": "MouseLink",
      "identityName": "VynovaLabs.MouseLinkDesktop",
      "publisher": "CN=Vynova Labs",
      "publisherDisplayName": "Vynova Labs",
      "displayName": "MouseLink Desktop",
      "backgroundColor": "transparent",
      "showNameOnTiles": true,
      "languages": [
        "en-US"
      ],
      "artifactName": "MouseLink-Desktop-${version}-${arch}.msix"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "synopsis": "Control this computer from your phone",
      "maintainer": "Vynova Labs"
    }
  }
}
